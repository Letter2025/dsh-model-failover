{
  "name": "dsh-model-failover",
  "version": "0.1.3",
  "description": "Two-level model circuit breaker with failover for DeepSeek Harness: trip a model or a whole provider after repeated request failures and route the next request to a configured fallback",
  "author": "Letter2025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Letter2025/dsh-model-failover.git"
  },
  "bugs": {
    "url": "https://github.com/Letter2025/dsh-model-failover/issues"
  },
  "homepage": "https://github.com/Letter2025/dsh-model-failover",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "circuit-breaker",
    "failover",
    "high-availability",
    "model-routing",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "skills"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  }
}
