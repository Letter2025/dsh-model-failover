{
  "name": "dsh-model-failover",
  "version": "0.1.9",
  "description": "Two-level model circuit breaker with failover for DeepSeek Harness: trip a model or a whole provider after repeated request failures and route the next request to a configured fallback",
  "author": "Letter2025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Letter2025/dsh-model-failover.git"
  },
  "bugs": {
    "url": "https://github.com/Letter2025/dsh-model-failover/issues"
  },
  "homepage": "https://github.com/Letter2025/dsh-model-failover",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "circuit-breaker",
    "failover",
    "high-availability",
    "model-routing",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "skills"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.4 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.4 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.4 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.4 || ^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.0 || ~3.18.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-fs-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "@deepseek-ai/dsh-working-directory": "0.2.2-alpha.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  }
}
